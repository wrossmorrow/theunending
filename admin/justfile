# Admin API just recipes

source_folder := "api"

# Install dependencies
install:
    uv sync

# Format code
format source=source_folder:
    uv run ruff format {{source}}

# Lint code
lint source=source_folder:
    uv run ruff check {{source}}

# Run type checks
typecheck source=source_folder:
    uv run mypy {{source}}

# Run the local server
run host="0.0.0.0" port="8000":
    uv run uvicorn api.main:api --host {{host}} --port {{port}}

# Run unit tests
test *flags="":
    uv run pytest {{flags}}
