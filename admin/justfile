# Admin API just recipes

image_name := "ghcr.io/wrossmorrow/theunending"
image_tag := `git rev-parse --short HEAD`

# List targets and exit
default:
    just --list

# Install dependencies
install:
    uv sync

# Format code
format:
    uv run ruff format .

# Lint code
lint:
    uv run ruff check .

# Run type checks
typecheck:
    uv run mypy .

# Run the local server
run host="0.0.0.0" port="8000":
    uv run uvicorn api.main:api --host {{ host }} --port {{ port }}

# Run the mock external job system server
mock-jobs:
    uv run uvicorn api.mocks.jobs:api --host 0.0.0.0 --port 8080

# Run unit tests
test *flags="tests/test_main.py":
    uv run pytest {{ flags }}

# Run integration tests
test-integration:
    uv run pytest tests/integration

# Containerize the application
containerize:
    docker build . -t {{ image_name }}:{{ image_tag }}

# Generate SQL DDL for database tables to a file
db-create output="sql/create_tables.sql":
    uv run python scripts/generate_db_sql.py {{ output }}

# Bring up compose setup
up *flags="":
    docker compose up --build {{ flags }}

# Bring down compose setup
down *flags="":
    docker compose down {{ flags }}

# exec psql against compose setup
psql:
    set -a && source .env && set +a \
        && PGPASSWORD="${POSTGRES_PASSWORD}" psql -h localhost -p 5432 -U ${POSTGRES_USER}

# exec psql -f against compose setup, for a listed file
psql-f file:
    [ -f {{file}} ] \
        && set -a && source .env && set +a \
        && PGPASSWORD="${POSTGRES_PASSWORD}" psql -h localhost -p 5432 -U ${POSTGRES_USER} -f {{file}}
